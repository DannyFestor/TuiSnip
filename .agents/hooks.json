{
  "tuisnip-guards": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [{ "type": "command", "command": "scripts/agent/adapters/antigravity.sh pre", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [{ "type": "command", "command": "scripts/agent/adapters/antigravity.sh post", "timeout": 120 }]
      }
    ],
    "PreInvocation": [
      { "type": "command", "command": "scripts/agent/adapters/antigravity.sh pre-invocation", "timeout": 10 }
    ],
    "Stop": [
      { "type": "command", "command": "scripts/agent/adapters/antigravity.sh stop", "timeout": 300 }
    ]
  }
}
